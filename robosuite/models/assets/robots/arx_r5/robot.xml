<mujoco model="arx_r5">
    <!-- Converted from ARXroboticsX/ARX_Model R5/R5a. Meshes are not included: run robosuite/scripts/download_arx_r5_meshes.py -->
    <actuator>
        <!-- Torque limits from arx5-sdk (X5/L5 family): include/app/config.h, joint_torque_max -->
        <motor ctrllimited="true" ctrlrange="-30.0 30.0" joint="joint1" name="torq_j1"/>
        <motor ctrllimited="true" ctrlrange="-40.0 40.0" joint="joint2" name="torq_j2"/>
        <motor ctrllimited="true" ctrlrange="-30.0 30.0" joint="joint3" name="torq_j3"/>
        <motor ctrllimited="true" ctrlrange="-15.0 15.0" joint="joint4" name="torq_j4"/>
        <motor ctrllimited="true" ctrlrange="-10.0 10.0" joint="joint5" name="torq_j5"/>
        <motor ctrllimited="true" ctrlrange="-10.0 10.0" joint="joint6" name="torq_j6"/>
    </actuator>
    <asset>
        <!-- Real ARX R5 look: all dark, matte black beams, dark graphite motor housings, green LED strip on the forearm -->
        <material name="r5_black" rgba="0.05 0.05 0.055 1" specular="0.15" shininess="0.15"/>
        <material name="r5_graphite" rgba="0.13 0.13 0.14 1" specular="0.35" shininess="0.35"/>
        <material name="r5_led" rgba="0.1 1.0 0.25 1" emission="1.0" specular="0" shininess="0"/>
        <mesh name="base_link" file="meshes/base_link.STL"/>
        <mesh name="link1" file="meshes/link1.STL"/>
        <mesh name="link2" file="meshes/link2.STL"/>
        <mesh name="link3" file="meshes/link3.STL"/>
        <mesh name="link4" file="meshes/link4.STL"/>
        <mesh name="link5" file="meshes/link5.STL"/>
        <mesh name="link6" file="meshes/link6.STL"/>
    </asset>
    <worldbody>
        <body name="base" pos="0 0 0">
            <!-- robot view -->
            <camera mode="fixed" name="robotview" pos="1.0 0 0.4" quat="0.653 0.271 0.271 0.653"/>
            <inertial pos="-0.00013359 6.672e-05 0.031672" quat="0.5 0.5 -0.5 0.5" mass="0.42272" diaginertia="0.0002 0.00019 0.00019"/>
            <!-- mount attached here -->
            <!-- *_col geoms have collisions disabled: phantom only needs kinematics + rendering, and the
                 convex hulls of the R5 link meshes otherwise jam the folded arm against the mount/base. -->
            <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_graphite" mesh="base_link" name="base_vis"/>
            <geom type="mesh" contype="0" conaffinity="0" rgba="0.89804 0.91765 0.92941 1" mesh="base_link" name="base_col"/>
            <body name="link1" pos="0 0 0.0565">
                <inertial pos="0.0050395 -0.0077407 0.020897" quat="0.632157 0.714526 -0.263733 0.142391" mass="0.096804" diaginertia="0.000118945 9.40205e-05 4.70346e-05"/>
                <!-- Joint ranges: arx5-sdk L5 config (R5 runs as L5), joint_pos_min / joint_pos_max,
                     real-stanford/arx5-sdk include/app/config.h @ 21da61b (2024-11-06). -->
                <joint name="joint1" pos="0 0 0" axis="0 0 1" limited="true" range="-3.14 2.618" damping="0.1" armature="0.01"/>
                <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_graphite" mesh="link1" name="link1_vis"/>
                <geom type="mesh" contype="0" conaffinity="0" rgba="0.56471 0.56471 0.56471 1" mesh="link1" name="link1_col"/>
                <body name="link2" pos="0.02 0 0.047">
                    <inertial pos="-0.12992 -0.0011822 -2.6366e-05" quat="0.501263 0.501263 0.498734 0.498734" mass="1.1988" diaginertia="0.0164704 0.01646 0.000649595"/>
                    <joint name="joint2" pos="0 0 0" axis="0 1 0" limited="true" range="-0.05 3.50" damping="0.1" armature="0.01"/>
                    <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_black" mesh="link2" name="link2_vis"/>
                    <geom type="mesh" contype="0" conaffinity="0" rgba="0.79216 0.81961 0.93333 1" mesh="link2" name="link2_col"/>
                    <body name="link3" pos="-0.264 0 0" quat="-3.67321e-06 -1 0 0">
                        <inertial pos="0.16181 0.0011723 -0.05455" quat="0.518857 0.484372 0.465704 0.52848" mass="0.84082" diaginertia="0.0084909 0.00841207 0.000747034"/>
                        <joint name="joint3" pos="0 0 0" axis="0 1 0" limited="true" range="-0.1 3.20" damping="0.1" armature="0.01"/>
                        <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_black" mesh="link3" name="link3_vis"/>
                        <geom type="mesh" contype="0" conaffinity="0" rgba="0.89804 0.91765 0.92941 1" mesh="link3" name="link3_col"/>
                        <!-- Green LED strips: emissive boxes filling the 2 mm deep niche the CAD mesh has on each side of the forearm
                             (niche floor y=+0.023 / -0.025, x 0.051-0.175, z -0.070..-0.051; outer faces y=+0.025 / -0.027) -->
                        <geom type="box" size="0.062 0.0006 0.0095" pos="0.113 0.0236 -0.0605" contype="0" conaffinity="0" group="1" material="r5_led" name="link3_led_pos_vis"/>
                        <geom type="box" size="0.062 0.0006 0.0095" pos="0.113 -0.0256 -0.0605" contype="0" conaffinity="0" group="1" material="r5_led" name="link3_led_neg_vis"/>
                        <body name="link4" pos="0.245 -5e-05 -0.06">
                            <inertial pos="0.041751 0.0054236 -0.03337" quat="0.919386 -0.0641253 0.311071 -0.23206" mass="0.12432" diaginertia="0.000303193 0.000235316 0.000101491"/>
                            <joint name="joint4" pos="0 0 0" axis="0 1 0" limited="true" range="-1.6 1.55" damping="0.05" armature="0.005"/>
                            <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_graphite" mesh="link4" name="link4_vis"/>
                            <geom type="mesh" contype="0" conaffinity="0" rgba="0.79216 0.81961 0.93333 1" mesh="link4" name="link4_col"/>
                            <body name="link5" pos="0.073914 5e-05 -0.083391">
                                <inertial pos="-8.3435e-05 -1.5428e-05 0.052216" quat="0.998247 0 -0.0591776 0" mass="0.63601" diaginertia="0.000848329 0.00082 0.000251671"/>
                                <joint name="joint5" pos="0 0 0" axis="0 0 1" limited="true" range="-1.57 1.57" damping="0.05" armature="0.005"/>
                                <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_graphite" mesh="link5" name="link5_vis"/>
                                <geom type="mesh" contype="0" conaffinity="0" rgba="0.69804 0.69804 0.69804 1" mesh="link5" name="link5_col"/>
                                <body name="link6" pos="0.025286 0 0.083391" quat="-3.67321e-06 1 0 0">
                                    <inertial pos="0.041697 2.4368e-05 0.00014464" quat="0.5 0.5 -0.5 0.5" mass="0.44089" diaginertia="0.0005 0.00038 0.00028"/>
                                    <joint name="joint6" pos="0 0 0" axis="1 0 0" limited="true" range="-2.0 2.0" damping="0.05" armature="0.005"/>
                                    <!-- Wrist/gripper housing stays with the arm; only the fingers live in the gripper model -->
                                    <geom type="mesh" contype="0" conaffinity="0" group="1" material="r5_graphite" mesh="link6" name="link6_vis"/>
                                    <geom type="mesh" contype="0" conaffinity="0" rgba="0.89804 0.91765 0.92941 1" mesh="link6" name="link6_col"/>
                                    <!-- Gripper mount frame: rotate so that local +z (robosuite approach axis) = link6 +x -->
                                    <body name="right_hand" pos="0 0 0" quat="0.7071068 0 0.7071068 0">
                                        <!-- This camera points out from the eef. -->
                                        <camera mode="fixed" name="eye_in_hand" pos="0.05 0 0" quat="0 0.707108 0.707108 0" fovy="75"/>
                                        <!-- To add gripper -->
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>
